{
  "name": "@hart365/pp-md-pptb-edition",
  "version": "1.2.2",
  "displayName": "PP-MD Power Platform Markdown Document Generator",
  "description": "Generate Power Platform documentation from either Solution ZIP files or direct Dataverse connection",
  "author": "Mike Hartley",
  "contributors": [
    {
      "name": "Mike Hartley",
      "url": "https://HartOfTheMidlands.co.uk"
    }
  ],
  "type": "module",
  "main": "index.html",
  "icon": "icons/pp-md.svg",
  "configurations": {
    "repository": "https://github.com/Hart365/pp-md-pptb-edition",
    "readmeUrl": "https://raw.githubusercontent.com/Hart365/pp-md-pptb-edition/refs/heads/main/README.md",
    "website": "https://github.com/Hart365/pp-md-pptb-edition"
  },
  "cspExceptions": {
    "connect-src": [
      {
        "domain": "api.github.com",
        "exceptionReason": "Optionally checks GitHub Releases when the user requests an update check.",
        "optional": true
      }
    ]
  },
  "features": {
    "multiConnection": "none",
    "connectionRequirement": "optional",
    "minAPI": "1.2.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "ACCESSIBILITY.MD",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/PP-MD-PPTB-Edition-HomePage.png",
    "docs/PP-MD-PPTB-Edition-DocHeader.png",
    "docs/PP-MD-PPTB-Edition-DocGeneration.png"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/normalize-dist-assets.mjs",
    "build:with-maps": "tsc && vite build --mode debug && node scripts/normalize-dist-assets.mjs",
    "preview": "vite preview",
    "validate": "node node_modules/@pptb/validate/dist/cli.js",
    "validate:offline": "node scripts/validate-offline.cjs",
    "validate:dist": "node scripts/validate-dist.cjs",
    "validate:publish": "npm run validate:offline && npm run build && npm run validate:dist && npm pack --dry-run",
    "test:contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run validate:offline && npm run lint && npm run type-check && npm run test:unit && npm run test:contrast && npm run build && npm run validate:dist",
    "finalize-package": "npm run validate:publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pptb/types": "^1.2.5",
    "@pptb/validate": "1.0.2",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.12.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "xlsx-js-style": "^1.2.0"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hart365/pp-md-pptb-edition.git"
  },
  "homepage": "https://github.com/Hart365/pp-md-pptb-edition#readme",
  "bugs": {
    "url": "https://github.com/Hart365/pp-md-pptb-edition/issues"
  },
  "keywords": [
    "powerplatform",
    "documentation",
    "dataverse",
    "solution",
    "markdown"
  ],
  "license": "MIT"
}
