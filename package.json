{
  "name": "@powerplatform/pp-md-tool",
  "version": "1.0.0",
  "displayName": "PP-MD Power Platform Markdown Document Generator",
  "description": "Generate Power Platform documentation from either Solution ZIP files or direct Dataverse connection",
  "author": "Mike Hartley",
  "contributors": [
    {
      "name": "Mike Hartley",
      "url": "https://HartOfTheMidlands.co.uk"
    }
  ],
  "type": "module",
  "main": "index.html",
  "icon": "pp-md.svg",
  "configurations": {
    "repository": "https://github.com/Hart365/pp-md-pptb-edition/",
    "readmeUrl": "https://raw.githubusercontent.com/Hart365/pp-md-pptb-edition/main/README.md",
    "website": "https://github.com/Hart365/pp-md-pptb-edition/"
  },
  "features": {
    "multiConnection": "none",
    "minAPI": "1.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:with-maps": "tsc && vite build --mode debug",
    "preview": "vite preview",
    "validate": "pptb-validate package.json",
    "validate:offline": "pptb-validate --skip-url-checks package.json",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run validate:offline && npm run lint && npm run type-check && npm run test:unit && npm run build",
    "finalize-package": "npm install --save-exact --save-dev --package-lock-only"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.2",
    "jszip": "^3.10.1",
    "mermaid": "^11.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pptb/types": "^1.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hart365/pp-md-pptb-edition.git"
  },
  "keywords": [
    "powerplatform",
    "documentation",
    "dataverse",
    "solution",
    "markdown"
  ],
  "license": "MIT"
}
